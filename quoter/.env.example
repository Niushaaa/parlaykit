# --- chain -------------------------------------------------------------
# Polygon Amoy testnet (recommended for the demo)
CHAIN_ID=80002
RPC_URL=https://rpc-amoy.polygon.technology
# RPC the browser wallet should use when adding the network (defaults to RPC_URL)
PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
# Contract addresses: leave empty to read contracts/deployments/<CHAIN_ID>.json
ENGINE=
VAULT=
USDC=
CTF=

# --- keys --------------------------------------------------------------
# Quote-signing key. Its address must equal ParlayEngine.quoteSigner (QUOTE_SIGNER at deploy).
# Generate one with: npm run keygen
QUOTER_PRIVATE_KEY=
# Owner of MockConditionalTokens (the deployer) — only for scripts/resolve.js on testnet
ADMIN_PRIVATE_KEY=

# --- behaviour ---------------------------------------------------------
PORT=8787
QUOTE_TTL=90
# DEMO=1 also serves the fictional demo venue (for the offline demo page)
DEMO=0
